<%= render(Core::Navigation::StepIndicatorComponent.new(Invitation::AO_STEPS, 0)) if @invitation.authorized_official? %>
<%= render(Core::Navigation::StepIndicatorComponent.new(Invitation::CD_STEPS, 0)) if @invitation.credential_delegate? %>
<section>
  <div class="usa-alert usa-alert--warning margin-bottom-4">
    <div class="usa-alert__body">
      <p class="usa-alert__text">
        This invitation will expire in <strong><%= @expiration %></strong>.
      </p>
    </div>
  </div>

  <div class="usa-prose">
    <% if @invitation.authorized_official? %>
      <p>You've been invited to register <strong><%= @organization.name %> (NPI <%= @organization.npi %>)</strong> in the Data at the Point of Care (DPC) Portal.</p>
      <p>To accept your invitation as an Authorized Official you must:</p>
    <% end %>
    <% if @invitation.credential_delegate? %>
      <p>You've been delegated by <strong><%= @organization.name %></strong> to manage access to the Data at the Point of Care (DPC) API.</p>
      <p>To accept your invitation as a Credential Delegate you must:</p>
    <% end %>

    <div class="margin-y-1">
      <%# TODO: update musts for both AO and CD %>
      <ul class="usa-icon-list">
        <% @musts.each do |must| %>
          <li class="usa-icon-list__item">
            <div class="usa-icon-list__icon">
              <%= render Core::Icon::UswdsComponent.new('check_circle', additional_classes: @list_styles) %>
            </div>
            <div class="usa-icon-list__content">
              <%= must %>
            </div>
          </li>
        <% end %>
      </ul>
    </div>
  </div>

  <%= link_to 'Begin registration', accept_organization_invitation_path(@organization, @invitation), class: 'usa-button margin-y-3' if @invitation.authorized_official? %>
  <%= link_to 'Get started', confirm_cd_organization_invitation_path(@organization, @invitation), class: 'usa-button margin-y-3' if @invitation.credential_delegate? %>
</section>
