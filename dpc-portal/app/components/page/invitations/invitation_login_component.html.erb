<%= render(Core::Navigation::StepIndicatorComponent.new(Invitation::AO_STEPS, 1)) if @invitation.authorized_official? %>
<%= render(Core::Navigation::StepIndicatorComponent.new(Invitation::CD_STEPS, 1)) if @invitation.credential_delegate? %>
<div>
  <p>You'll need to verify your identity before accessing this organization.  You can choose from any of the supported government-approved identity verification services, including Login.gov, ID.me, and CLEAR.</p>
  <p>Info to have ready:</p>
  <ul>
    <% @musts.each do |must| %>
      <li class="margin-top-2"><%= must %></li>
    <% end %>
  </ul>

  <div class="usa-alert usa-alert--warning margin-y-4">
    <div class="usa-alert__body">
      <h2 class="usa-alert__heading">Before continuing</h2>
      <p class="usa-alert__text">
        Already have a CLEAR, ID.me, or Login.gov account under a different email? If so, add your invited email address to that account before you start. Otherwise, you may not be able to complete the verification process.
      </p>
    </div>
  </div>

  <div class="grid-row margin-x-neg-205">
    <div class="grid-col-12 mobile-lg:grid-col-10 tablet:grid-col-8 desktop:grid-col-6 padding-x-205 margin-bottom-3">
      <h2 class="font-body-sm">Choose one of the following:</h2>

      <div class="padding-y-3">
        <%
          csps = [
            { id: :clear, logo_class: 'clear-login-button__logo', text: 'Verify with CLEAR', verify_path: login_organization_invitation_url(@invitation.provider_organization, @invitation, @invitation.token, provider: :clear) },
            { id: :id_me, logo_class: 'idme-login-button__logo', text: 'Verify with ID.me', verify_path: login_organization_invitation_url(@invitation.provider_organization, @invitation, @invitation.token, provider: :id_me) },
            { id: :login_dot_gov, logo_class: 'lg-login-button__logo', text: 'Verify with Login.gov', verify_path: login_organization_invitation_url(@invitation.provider_organization, @invitation, @invitation.token, provider: :login_dot_gov) },
          ]
        %>
        <% csps.each do |csp| %>
          <%= button_to csp[:verify_path], class: 'usa-button width-full margin-bottom-1', data: { turbo: false } do %>
            <span class="<%= csp[:logo_class] %>"><%= csp[:text] %></span>
          <% end %>
        <% end %>
      </div>

      <%= render(Core::Navigation::SystemUseAgreementLinkComponent.new) %>
    </div>
  </div>

  <h2 class="font-body-sm">Need help signing in?</h2>
  <%= render(Core::Navigation::CspHelpLinksComponent.new) %>
</div>
