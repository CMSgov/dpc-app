<h1>Your identity could not be verified with <%= @csp_display_name %></h1>
<div class="usa-prose">
  <p>You've been returned to the DPC Portal because your identity verification with <%= @csp_display_name %> wasn't completed.</p>

  <% if @current_csp == :login_dot_gov %>
    <p><%= link_to 'Get help from Login.gov', 'https://www.login.gov/help/verify-your-identity/overview/' %></p>
    <p><%= link_to 'Contact Login.gov ', 'https://www.login.gov/contact/' %></p>
  <% elsif @current_csp == :id_me %>
    <p><%= link_to 'ID.me Help Center', 'https://help.id.me/hc/en-us' %></p>
  <% end %>
</div>

<div class="margin-y-3">
  <%= link_to 'Back to sign in', sign_in_destination, class: 'usa-button usa-button--outline' %>
</div>

<div class="usa-prose">
  <p><span class="text-bold">Still need help?</span> Contact us at <a href="mailto:dpcinfo@cms.hhs.gov">dpcinfo@cms.hhs.gov</a></p>
</div>
