<div>
    <h1>Existing account found</h1>
    <div class="usa-alert usa-alert--info margin-bottom-4">
        <div class="usa-alert__body">
            <p class="usa-alert__text">This account was already created using:</p>
            <p><strong><%= @masked_email %></strong> and <strong><%= @display_name %></strong></p>
        </div>
    </div>
    <div>
        <p>To continue, either:</p>
        <ul class="merge-options">
            <li>Link this new identity provider to your account. Sign in with the provider you originally used to confirm it's you. After that, you can use either provider to sign in.</li>
            <li>Start over with your original provider. Sign out of the DPC Portal and the identity provider you just used, then return and sign in with <%= @display_name %>. If you skip signing out of the identity provider, you'll be automatically signed back in with it.</li>
        </ul>
    </div>
    <div>
        <%= button_to helpers.omniauth_authorize_path(@csp_code), class: 'usa-button margin-bottom-1', data: { turbo: false } do %>
            <span>Link to existing account</span>
        <% end %>
    </div>
</div>
