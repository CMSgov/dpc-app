    <changeSet id="convert-patient-gender-to-string" author="MEsposito">
        <!-- Update column types -->
        <sql>
            ALTER TABLE PATIENTS ALTER COLUMN gender TYPE VARCHAR(32) USING gender::VARCHAR;
        </sql>

        <!-- Map existing ints to strings -->
        <!-- 0=MALE, 1=FEMALE, 2=OTHER, 3=UNKNOWN, 4=NULL -->
        <update tableName="PATIENTS">
            <column name="gender" value="MALE"/>
            <where>gender = '0'</where>
        </update>
        <update tableName="PATIENTS">
            <column name="gender" value="FEMALE"/>
            <where>gender = '1'</where>
        </update>
        <update tableName="PATIENTS">
            <column name="gender" value="OTHER"/>
            <where>gender = '2'</where>
        </update>
        <update tableName="PATIENTS">
            <column name="gender" value="UNKNOWN"/>
            <where>gender = '3'</where>
        </update>
        <update tableName="PATIENTS">
            <column name="gender" valueComputed="'NULL'"/>
            <where>gender = '4'</where>
        </update>

        <rollback>
            <!-- I want to be able to roll these back if the stuff hits the fan. -->
            <sql>
                ALTER TABLE PATIENTS ALTER COLUMN gender TYPE SMALLINT
                    USING (CASE gender
                        WHEN 'MALE' THEN '0'
                        WHEN 'FEMALE' THEN '1'
                        WHEN 'OTHER' THEN '2'
                        WHEN 'UNKNOWN' THEN '3'
                        WHEN 'NULL' THEN '4'
                        ELSE gender
                    END)::SMALLINT;
            </sql>
        </rollback>
    </changeSet>

    <changeSet id="remove-attribution-period-end-default" author="MEsposito">
        <dropDefaultValue tableName="ATTRIBUTIONS"
                          columnName="period_end"
                          columnDataType="TIMESTAMP WITH TIME ZONE"/>
        <rollback>
            <addDefaultValue tableName="ATTRIBUTIONS"
                             columnName="period_end"
                             columnDataType="TIMESTAMP WITH TIME ZONE"
                             defaultValueComputed="current_timestamp + ( 90 || ' day')::interval"/>
        </rollback>
    </changeSet>
