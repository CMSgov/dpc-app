        <rollback>
            <!-- I want to be able to roll these back if the stuff hits the fan. -->
            <sql>
                ALTER TABLE ORGANIZATION_CONTACTS ALTER COLUMN address_use TYPE SMALLINT
                    USING (CASE address_use
                        WHEN 'HOME' THEN '0'
                        WHEN 'WORK' THEN '1'
                        WHEN 'TEMP' THEN '2'
                        WHEN 'OLD' THEN '3'
                        WHEN 'NULL' THEN '4'
                        ELSE address_use
                    END)::SMALLINT;
                ALTER TABLE ORGANIZATION_CONTACTS ALTER COLUMN address_type TYPE SMALLINT
                    USING (CASE address_type
                        WHEN 'POSTAL' THEN '0'
                        WHEN 'PHYSICAL' THEN '1'
                        WHEN 'BOTH' THEN '2'
                        WHEN 'NULL' THEN '3'
                        ELSE address_type
                    END)::SMALLINT;
                ALTER TABLE ORGANIZATION_CONTACTS ALTER COLUMN name_use TYPE SMALLINT
                    USING (CASE name_use
                        WHEN 'USUAL' THEN '0'
                        WHEN 'OFFICIAL' THEN '1'
                        WHEN 'TEMP' THEN '2'
                        WHEN 'NICKNAME' THEN '3'
                        WHEN 'ANONYMOUS' THEN '4'
                        WHEN 'OLD' THEN '5'
                        WHEN 'MAIDEN' THEN '6'
