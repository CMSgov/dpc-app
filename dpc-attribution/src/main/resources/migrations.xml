    <changeSet id="convert-telecom-enums-to-string" author="MEsposito">
        <!-- Update column types -->
        <sql>
            ALTER TABLE CONTACT_TELECOMS ALTER COLUMN system TYPE VARCHAR(32) USING system::VARCHAR;
            ALTER TABLE CONTACT_TELECOMS ALTER COLUMN "use" TYPE VARCHAR(32) USING "use"::VARCHAR;
        </sql>

        <!-- Map existing ints to strings -->
        <!-- 0=PHONE, 1=FAX, 2=EMAIL, 3=PAGER, 4=URL, 5=SMS, 6=OTHER, 7=NULL -->
        <update tableName="CONTACT_TELECOMS">
            <column name="system" value="PHONE"/>
            <where>system = '0'</where>
        </update>
        <update tableName="CONTACT_TELECOMS">
            <column name="system" value="FAX"/>
            <where>system = '1'</where>
        </update>
        <update tableName="CONTACT_TELECOMS">
